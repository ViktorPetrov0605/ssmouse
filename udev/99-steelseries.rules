# SteelSeries HID access rules for ssmouse
#
# The Rival 3 Wireless exposes four HID interfaces.  Interface 3
# (usage page 0xFFC0, /dev/hidraw7 on the development machine) is the vendor
# control channel used for battery/DPI/info queries; interface 2 (usage page
# 0xFF00) is enumerated but has no working OUT endpoint.
#
# MODE="0666" makes the nodes world-writable (simple, works everywhere);
# TAG+="uaccess" additionally grants the logged-in seat user an ACL so the
# device keeps working when a stricter MODE is used.  Prefer uaccess on shared
# machines and drop MODE="0666" if you do not want world access.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", MODE="0666", TAG+="uaccess"

# Also tag the USB device nodes: the libusb-based hidapi backend ("hid")
# opens /dev/bus/usb/* instead of /dev/hidraw*.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", MODE="0666", TAG+="uaccess"

# Uncomment to restrict the rule to the Rival 3 Wireless (PID 0x1830) only.
# SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1830", MODE="0666", TAG+="uaccess"
